{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The server's own windows: the outputs on the displays, the stream graphics and the setup window. The setup window's title bar (titlebar.js) moves, minimizes, maximizes and closes it.",
  "windows": [
    "presentation-*",
    "stream-renderer",
    "setup"
  ],
  "permissions": [
    "core:default",
    "allow-api-request",
    "allow-local-server",
    "allow-close-setup",
    "allow-page-log",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
