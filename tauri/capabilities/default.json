{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The app's own windows: the manager's server list, and the server's output, stream graphics and setup windows.",
  "windows": [
    "main",
    "presentation-*",
    "stream-renderer",
    "setup"
  ],
  "permissions": [
    "core:default",
    "allow-api-request",
    "allow-local-server",
    "allow-close-setup",
    "allow-discovered-servers",
    "allow-local-server-status",
    "allow-start-local-server",
    "allow-page-log"
  ]
}
