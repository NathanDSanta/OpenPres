{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "OpenPres",
	"Version": "0.1.0.0",
	"Author": "OpenPres",
	"Description": "Control OpenPres from your Stream Deck: next and previous slide, clear, go live, props, cameras, media, timers and Bible passages. Keys show what is on screen.",
	"URL": "https://github.com/NathanDSanta/OpenPres",
	"Category": "OpenPres",
	"CategoryIcon": "imgs/plugin/category",
	"Icon": "imgs/plugin/marketplace",
	"CodePath": "bin/plugin.js",
	"PropertyInspectorPath": "ui/inspector.html",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24"
	},
	"UUID": "com.nathandsanta.openpres",
	"Actions": [
		{
			"Name": "Next",
			"UUID": "com.nathandsanta.openpres.next",
			"Icon": "imgs/actions/next/icon",
			"Tooltip": "Next slide, or the next verse when the Bible was shown last (like the arrow keys).",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/next/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Previous",
			"UUID": "com.nathandsanta.openpres.previous",
			"Icon": "imgs/actions/previous/icon",
			"Tooltip": "Previous slide, or the previous verse when the Bible was shown last (like the arrow keys).",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/previous/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Go to slide",
			"UUID": "com.nathandsanta.openpres.slide",
			"Icon": "imgs/actions/slide/icon",
			"Tooltip": "Jumps to a slide of what is on screen.",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/slide/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Clear",
			"UUID": "com.nathandsanta.openpres.clear",
			"Icon": "imgs/actions/clear/icon",
			"Tooltip": "Clears a layer, all of them, or everything with the audio.",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/clear/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Bible passage",
			"UUID": "com.nathandsanta.openpres.bible",
			"Icon": "imgs/actions/bible/icon",
			"Tooltip": "Shows a Bible passage.",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/bible/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Prop",
			"UUID": "com.nathandsanta.openpres.prop",
			"Icon": "imgs/actions/prop/icon",
			"Tooltip": "Shows or hides a prop or complement.",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/prop/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Camera",
			"UUID": "com.nathandsanta.openpres.camera",
			"Icon": "imgs/actions/camera/icon",
			"Tooltip": "Shows a camera on the video input layer.",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/camera/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Media",
			"UUID": "com.nathandsanta.openpres.media",
			"Icon": "imgs/actions/media/icon",
			"Tooltip": "Plays, pauses and skips media or audio, or plays a media folder.",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/media/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Mute bus",
			"UUID": "com.nathandsanta.openpres.mute",
			"Icon": "imgs/actions/mute/icon",
			"Tooltip": "Mutes or unmutes an audio bus.",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/mute/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Timer",
			"UUID": "com.nathandsanta.openpres.timer",
			"Icon": "imgs/actions/timer/icon",
			"Tooltip": "Starts, pauses or resets a timer, and shows its time.",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/timer/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Stream",
			"UUID": "com.nathandsanta.openpres.stream",
			"Icon": "imgs/actions/stream/icon",
			"Tooltip": "Goes live or stops the stream, and shows how long it has been live.",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/stream/key",
					"ShowTitle": false
				}
			]
		}
	]
}