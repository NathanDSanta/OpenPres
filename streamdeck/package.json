{
	"name": "openpres-streamdeck",
	"private": true,
	"version": "0.1.0",
	"description": "Stream Deck plugin for OpenPres: next/previous, clear, go live, props, timers, Bible and more.",
	"type": "module",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.nathandsanta.openpres\"",
		"typecheck": "tsc --noEmit",
		"validate": "streamdeck validate com.nathandsanta.openpres.sdPlugin --no-update-check",
		"pack": "npm run build && streamdeck pack com.nathandsanta.openpres.sdPlugin --output dist --force --no-update-check",
		"test": "npm run build && node --test --test-concurrency=1 \"test/*.test.ts\"",
		"icons": "node scripts/icons.ts"
	},
	"dependencies": {
		"@elgato/streamdeck": "3.0.4",
		"@elgato/utils": "^0.6.2"
	},
	"devDependencies": {
		"@elgato/cli": "1.10.4",
		"@rollup/plugin-commonjs": "^29.0.2",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.1.0",
		"@tsconfig/node20": "^20.1.2",
		"@types/node": "~20.19.0",
		"lucide": "^1.73.0",
		"rollup": "^4.0.2",
		"tslib": "^2.6.2",
		"typescript": "^5.2.2",
		"ws": "^8.18.0"
	},
	"engines": {
		"node": ">=22.18"
	}
}
